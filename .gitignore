# .gitignore para proyecto Django/Python + Desktop builds

# =========================
# Python cache / bytecode
# =========================
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# =========================
# Virtual environments
# =========================
env/
venv/
.venv/
ENV/
test_env/

# =========================
# Distribution / packaging
# =========================
build/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
pip-wheel-metadata/

# PyInstaller
*.manifest
*.spec

# =========================
# Testing / coverage
# =========================
.tox/
*.cover
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# =========================
# Django
# =========================
*.log
local_settings.py

# Database (SQLite)
db.sqlite3
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Media uploads
media/

# Collected static (Django collectstatic output)
staticfiles/

# ⚠️ IMPORTANTE:
# NO ignorar /static/ porque aquí están tus assets fuente (css/img/video)
# (Por eso NO hay /static/ aquí)

# =========================
# IDEs
# =========================
.vscode/
.idea/
.mypy_cache/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Secret and environment files
# =========================
.env
.env.*
*.local

# =========================
# Editor temporary files
# =========================
*~
*.swp

# =========================
# Desktop app data / exports (si alguna vez las guardas dentro del proyecto)
# =========================
data/
backups/
exports/
reports/

# Otros
desktop_app/
build/desktop_app/

