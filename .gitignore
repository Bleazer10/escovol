# .gitignore generado para el proyecto escovol
# Reglas comunes para Python/Django, entornos virtuales y builds

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
pip-wheel-metadata/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so keep the spec if you need it.
dist/
build/
*.manifest
*.spec

# Installer logs
pip-log.txt

# Unit test / coverage reports
.tox/
*.cover
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Django stuff:
*.log
local_settings.py
db.sqlite3
media/
staticfiles/

# If you collect static files to a local folder
/static/

# Virtual environments
env/
venv/
.venv/
ENV/
test_env/

# VS Code / JetBrains
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Pyright / mypy
.mypy_cache/

# Sphinx documentation
docs/_build/

# Generated files
*.pyc
*.pyo
*.pyd

# Secret and environment files
.env
.env.*
*.local

# Editor temporary files
*~
*.swp

# Other
desktop_app/
build/desktop_app/
